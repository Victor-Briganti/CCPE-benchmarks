#!/usr/bin/env sh

name=$1
task=$2
param=$3

if [[ "$name" != "default" ]] && [[ "$name" != "memo" ]] && [[ "$name" != "fast" ]]; then
  for ((i = 0 ; i < 10; i++)); do
    OMP_PROC_BIND=true perf stat -e power/energy-pkg/,power/energy-cores/,power/energy-ram/ -o /home/aJoaoBriganti/benchmarks/apps/kmeans/output/perf_kdd_cup_energy_$name$task-drop$param-$i /home/aJoaoBriganti/benchmarks/apps/kmeans/bin/kmeans_$name.a < /home/aJoaoBriganti/benchmarks/apps/kmeans/input/kdd_cup.txt > /dev/null
  done
elif [[ "$name" == "memo" ]]; then
  for ((i = 0 ; i < 10; i++)); do
    OMP_PROC_BIND=true perf stat -e power/energy-pkg/,power/energy-cores/,power/energy-ram/ -o /home/aJoaoBriganti/benchmarks/apps/kmeans/output/perf_kdd_cup_energy_$name$task-threshold$param-$i /home/aJoaoBriganti/benchmarks/apps/kmeans/bin/kmeans_$name.a < /home/aJoaoBriganti/benchmarks/apps/kmeans/input/kdd_cup.txt > /dev/null
  done
else
  for ((i = 0 ; i < 10; i++)); do
    OMP_PROC_BIND=true perf stat -e power/energy-pkg/,power/energy-cores/,power/energy-ram/ -o /home/aJoaoBriganti/benchmarks/apps/kmeans/output/perf_kdd_cup_energy_$name$task-$i /home/aJoaoBriganti/benchmarks/apps/kmeans/bin/kmeans_$name.a < /home/aJoaoBriganti/benchmarks/apps/kmeans/input/kdd_cup.txt > /dev/null
  done
fi

